# ============================================================
# Kafil Music — environment configuration (copy to .env)
# Generate a strong secret:  python -c "import secrets; print(secrets.token_hex(32))"
# ============================================================

# --- Security ---
JWT_SECRET_KEY=CHANGE_ME_run_the_command_above
OTP_EXPIRY_MINUTES=5

# --- Database ---
# Option 1: Dev (zero-setup, SQLite)
DATABASE_URL=sqlite:///./kafil_music.db

# Option 2: Self-hosted PostgreSQL
# DATABASE_URL=postgresql://user:password@localhost:5432/kafil_music

# Option 3: Supabase (direct connection — no pooler)
# Get this from: Supabase Dashboard → Settings → Database → Connection String
# Select "Connection string" → "URI" → copy the postgresql:// URL
# DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[YOUR_PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres

# Option 4: Supabase with connection pooler (recommended for serverless/edge)
# Use this when deploying on Vercel, Cloudflare Workers, or any serverless
# DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[YOUR_PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
# USE_SUPABASE_POOLER=true

# --- CORS (comma-separated origins; * for dev only) ---
CORS_ORIGINS=*

# --- Cloud Storage (S3-compatible — ParsPack / AWS S3 / MinIO) ---
# فعال‌سازی: S3_ENABLED=true
# ParsPack example endpoint: https://c872409.parspack.net
# AWS S3 example endpoint:  https://s3.<region>.amazonaws.com
# MinIO local example:      http://localhost:9000
S3_ENABLED=true
S3_ENDPOINT_URL=https://c872409.parspack.net
S3_BUCKET_NAME=kafil-music           # ← نام باکت را از پنل پارس‌پک بگیرید
S3_ACCESS_KEY=YOUR_ACCESS_KEY
S3_SECRET_KEY=YOUR_SECRET_KEY
S3_REGION=us-east-1
# پارس‌پک از path-style استفاده می‌کند (روشن بگذارید)
S3_PATH_STYLE=true

# --- Recommender tuning ---
RECO_CONTENT_DIM=48
RECO_CF_DIM=32
# Default hybrid blend (collaborative vs. content). Must sum with pop weight <= 1.
RECO_W_COLLAB=0.5
RECO_W_CONTENT=0.35
RECO_W_POPULARITY=0.15
# Real-time taste-vector learning rate (EMA) for the feedback loop
RECO_REALTIME_LR=0.15
# Candidate pool size fetched by the ANN retrieval stage before ranking
RECO_CANDIDATE_POOL=400
# Backends: cf = numpy | sklearn | implicit ;  ann = numpy | pgvector | faiss | annoy
RECO_CF_BACKEND=numpy
RECO_ANN_BACKEND=numpy
# Where fitted transformers / index artifacts are stored
RECO_ARTIFACT_DIR=./artifacts